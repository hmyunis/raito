APP_NAME=Raito
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0
APP_TIMEZONE=Africa/Addis_Ababa

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

MAX_JSON_BODY_BYTES=262144

APP_KEY=change_this_to_a_long_random_secret

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret
TELEGRAM_CONNECT_TIMEOUT_SECONDS=20
TELEGRAM_TIMEOUT_SECONDS=45
TELEGRAM_RETRY_ATTEMPTS=3

PAIRING_CODE_TTL_MINUTES=10
PAIRING_CODE_MAX_ATTEMPTS=5
REMOTE_PANEL_MAX_CHARS=4000

ADMIN_TOKEN=change_this_to_a_long_random_admin_token
MAX_EVENT_PAYLOAD_BYTES=12000
MAX_BATCH_EVENTS=50
MAX_SYNC_PANEL_IDS=100

DEPLOY_TOKEN=change_this_to_a_long_random_deploy_token
APP_BASE_URL=https://yourdomain.com
ANDROID_UPDATE_PROMPT_ENABLED=false
ANDROID_UPDATE_LATEST_VERSION=
ANDROID_UPDATE_MIN_SUPPORTED_VERSION=
ANDROID_UPDATE_DOWNLOAD_URL=
ANDROID_UPDATE_RELEASE_TITLE=
ANDROID_UPDATE_RELEASE_NOTES=
ANDROID_UPDATE_PUBLISHED_AT=
