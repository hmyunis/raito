Options -Indexes

<FilesMatch "^\.env$|^\.env\.example$|^docker-compose\.yml$">
    Require all denied
</FilesMatch>

RewriteEngine On

RewriteRule ^(app|migrations|scripts|storage|docker)(/|$) - [F,L]
RewriteRule ^\.git(/|$) - [F,L]
RewriteRule ^\.vscode(/|$) - [F,L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [QSA,L]
